# PassIt local environment template
#
# 1. Copy this file to `.env` in the repository root.
# 2. Replace only the values needed for your workstream.
# 3. Never commit `.env`, credentials, tokens, private keys, or real user data.
#
# Docker Compose reads the root `.env` automatically. The FastAPI settings
# loader also reads it during native development.

# -----------------------------------------------------------------------------
# Core application — required for local development
# -----------------------------------------------------------------------------
PASSIT_ENV=development
PASSIT_CORS_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000/v1
# Start MSW mocks in the browser instead of calling the API (frontend-only work).
NEXT_PUBLIC_API_MOCKS=false
# Let the web login page accept seed tokens (development only; P1 replaces with real login).
PASSIT_DEV_LOGIN=true

# Local PostgreSQL container credentials. These are development-only values.
POSTGRES_DB=passit
POSTGRES_USER=passit
POSTGRES_PASSWORD=passit

# Native FastAPI connection. Docker Compose builds its own URL using the three
# PostgreSQL values above and the internal hostname `postgres`.
PASSIT_DATABASE_URL=postgresql+psycopg://passit:passit@localhost:5432/passit

# Generate with: openssl rand -hex 32
# Use a different value in every shared environment.
PASSIT_JWT_SECRET=replace-with-a-random-64-character-value
PASSIT_JWT_ALGORITHM=HS256
PASSIT_SESSION_COOKIE_SECURE=false

# -----------------------------------------------------------------------------
# AWS — required only for P1/B3 cloud integration
# -----------------------------------------------------------------------------
# AWS Bedrock and S3 do not issue separate API keys. Both use AWS IAM.
#
# Local development:
#   - Ask P1 for access to the team's AWS account.
#   - Configure an AWS IAM Identity Center/SSO profile with the AWS CLI.
#   - Run: aws sso login --profile passit-dev
#   - Put only the profile name below; keep AWS credentials in ~/.aws.
#
# ECS/staging/demo:
#   - Use an ECS task role. Do not create long-lived access keys.
PASSIT_AWS_REGION=ap-southeast-1
PASSIT_AWS_PROFILE=passit-dev

# Find the model ID in AWS Console > Amazon Bedrock > Model catalog.
# The selected model must be enabled for the team's AWS account and region.
PASSIT_BEDROCK_MODEL_ID=replace-with-enabled-bedrock-model-id
PASSIT_BEDROCK_GUARDRAIL_ID=
PASSIT_BEDROCK_GUARDRAIL_VERSION=

# Create the bucket through the reviewed Terraform owned by P1.
# Bucket name, prefix and CloudFront domain are configuration, not secrets.
PASSIT_S3_BUCKET=replace-with-passit-media-bucket
PASSIT_S3_PREFIX=media/
PASSIT_CLOUDFRONT_DOMAIN=
PASSIT_MEDIA_SIGNED_URL_TTL_SECONDS=900

# -----------------------------------------------------------------------------
# Optional external services — leave blank unless the feature owner needs them
# -----------------------------------------------------------------------------
# MongoDB is optional and is not the primary PassIt database. The target stack
# uses PostgreSQL. If a workstream deliberately uses MongoDB Atlas, obtain the
# connection string from Atlas > Database > Connect > Drivers. Do not commit it.
PASSIT_MONGODB_URI=
PASSIT_MONGODB_DATABASE=passit

# Only needed for MongoDB Atlas administration/provisioning, not normal queries.
# Create these under Atlas > Access Manager > API Keys with minimum permissions.
PASSIT_MONGODB_ATLAS_PUBLIC_KEY=
PASSIT_MONGODB_ATLAS_PRIVATE_KEY=
PASSIT_MONGODB_ATLAS_PROJECT_ID=

# Obtain mapping credentials/tokens from the provider's developer portal.
PASSIT_ONEMAP_API_URL=https://www.onemap.gov.sg/api
PASSIT_ONEMAP_TOKEN=

# Optional approved external model service (OpenAI-compatible /chat/completions).
# Bedrock uses IAM instead of this. With neither set, prices use the heuristic.
PASSIT_LLM_API_URL=
PASSIT_LLM_API_KEY=
PASSIT_LLM_MODEL=

# The prototype must remain in mock mode and must not process real payments.
PASSIT_PAYMENT_MODE=mock

# -----------------------------------------------------------------------------
# Integration backends and business rules (B1-B3)
# -----------------------------------------------------------------------------
# `local` needs no AWS account: uploads are stored by the API and fee releases run
# in a background sweep. P1 switches staging/demo to `s3` and `eventbridge`
# after provisioning (see api/README.md, "AWS hand-off").
PASSIT_STORAGE_BACKEND=local
PASSIT_SCHEDULER_BACKEND=local
# Base URL the browser uses to reach the API; local upload URLs are built from it.
PASSIT_PUBLIC_API_URL=http://localhost:8000
PASSIT_LOCAL_MEDIA_DIR=.media

# EventBridge Scheduler target for fee release. Provisioned by P1 Terraform.
PASSIT_RELEASE_LAMBDA_ARN=
PASSIT_SCHEDULER_ROLE_ARN=

# Fee hold after handover: 10080 = 7 days. Use 1 in staging so demos show a real release.
PASSIT_FEE_HOLD_MINUTES=10080
# Background sweep that releases due fees (0 disables). Idempotent with EventBridge.
PASSIT_LOCAL_RELEASE_SWEEP_SECONDS=30
PASSIT_FREE_LISTING_LIMIT=3
